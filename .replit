modules = ["web", "python-base-3.13", "nodejs-24"]

[nix]
channel = "stable-25_05"
packages = ["postgresql", "python313Packages.psycopg"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python server.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5010
externalPort = 3001

[deployment]
deploymentTarget = "autoscale"
run = ["python", "server.py"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 30000
